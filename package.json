{
  "name": "banner-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tag": "node --env-file-if-exists=.env --import tsx src/cli/tag.ts",
    "eval:sample": "node --env-file-if-exists=.env --import tsx src/cli/eval-sample.ts",
    "typecheck": "tsc --noEmit",
    "recommend": "node --env-file-if-exists=.env --import tsx src/cli/recommend.ts",
    "runs": "node --env-file-if-exists=.env --import tsx src/cli/runs.ts",
    "report": "node --import tsx src/cli/report-runs.ts",
    "compose": "node --env-file-if-exists=.env --import tsx src/cli/compose.ts",
    "brief": "node --env-file-if-exists=.env --import tsx src/cli/brief.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "enrich": "node --env-file-if-exists=.env --import tsx src/cli/enrich.ts",
    "publish": "node --env-file-if-exists=.env --import tsx src/cli/publish.ts",
    "improve": "node --env-file-if-exists=.env --import tsx src/cli/improve.ts",
    "traffic": "node --env-file-if-exists=.env --import tsx src/cli/traffic.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.124",
    "@grpc/grpc-js": "^1.14.7",
    "@mastra/core": "^1.85.0",
    "@mastra/libsql": "^1.31.1",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
