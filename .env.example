# Gemini key for the application's model calls. Never commit the real one.
# Copy this file to .env and fill it in — .env is gitignored.
GOOGLE_GENERATIVE_AI_API_KEY=

# Cheapest tier is enough for category validation; banner copy uses a better model.
TAGGER_MODEL=gemini-3.5-flash-lite

# Firebase web app (projeto banner-generator-aeef1). A chave web do Firebase
# nao e segredo — ela identifica o projeto e quem protege os dados sao as
# Security Rules. Fica no .env mesmo assim, pela mesma regra do resto.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Credencial de servidor para escrever no Firestore e no Storage.
# Caminho de um arquivo de chave de conta de servico. Sem isso o app funciona
# normalmente contra os arquivos locais e so nao espelha para o Firebase.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional. Who starts out as an admin normally comes from config/people.json,
# which travels with the project so whoever receives it can sign in. Set this
# only in a deployment that does not want those addresses in a repository:
# when it is set, it replaces the file entirely.
ADMIN_EMAILS=
